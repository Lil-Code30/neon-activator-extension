{
  "name": "Neon Activator",
  "description": "A simple Chrome extension that activates neon lights on any webpage.",
  "version": "1.0.1",
  "manifest_version": 3,
  "action": {
    "default_icon": "hello_extensions.png"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "scripts/background/background.js"
  }
}
